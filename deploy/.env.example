# Copy this file to deploy/.env on the production host and chmod 600 it.
# Never commit deploy/.env or put real credentials in this example file.

COMPOSE_PROJECT_NAME=fundscope
# 同一发布标签同时标识 API/worker 镜像和包含已编译前端资源的 Caddy 镜像。
APP_IMAGE_TAG=local

# Caddy obtains and renews the certificate after DNS and ports 80/443 are ready.
DASHBOARD_DOMAIN=dashboard.example.com
ACME_EMAIL=ops@example.com

APP_ENV=production
APP_SERVICE_NAME=fundscope-api
APP_PORT=8000
UPLOAD_TEMP_DIR=/var/lib/fundscope/tmp/uploads
SOURCE_STORAGE_DIR=/var/lib/fundscope/source-files
DATABASE_BACKUP_DIR=/var/lib/fundscope/backups
SOURCE_RETENTION_DAYS=365
MAX_UPLOAD_BYTES=20971520
WORKER_IDLE_SLEEP_SECONDS=5

POSTGRES_DB=fund_dashboard
POSTGRES_USER=fund_dashboard
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
# URL-encode the password before putting it into DATABASE_URL.
DATABASE_URL=postgresql+psycopg://fund_dashboard:REPLACE_WITH_URL_ENCODED_DB_PASSWORD@db:5432/fund_dashboard

# Keep this empty when using the controlled host file below. Do not put a real
# QQ authorization code in this repository or in a shell command.
MAIL_IMAP_HOST=imap.qq.com
MAIL_IMAP_PORT=993
MAIL_IMAP_USERNAME=example@qq.com
MAIL_IMAP_PASSWORD=
# The API container writes only imap_password inside this controlled directory.
MAIL_IMAP_SECRET_DIR=/etc/fundscope
MAIL_IMAP_USE_SSL=true
MAIL_IMAP_MAILBOX=INBOX

# Tushare Pro token for benchmark index data (沪深300 etc.)
TUSHARE_TOKEN=
